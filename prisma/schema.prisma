generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PROVIDER
}

enum InstallationStatus {
  A_REPERER
  MESURES_PRISES
  PROD
  DISPATCH
  INSTALLE
}

enum InstallationType {
  TG
  STAND
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  passwordHash   String
  role           UserRole       @default(PROVIDER)
  active         Boolean        @default(true)
  phone          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  installations  Installation[]

  @@index([role, active])
}

model Installation {
  id               String             @id @default(cuid())
  banner           String
  storeName        String
  city             String
  supervisor       String?
  phone            String?
  status           InstallationStatus @default(A_REPERER)
  installationType InstallationType   @default(TG)
  techSheetUrl     String?
  deadline         DateTime?
  measurements     Json?
  photos           String[]           @default([])
  photoProofs      Json               @default("[]")
  providerId       String?
  provider         User?              @relation(fields: [providerId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([banner, storeName, city])
  @@index([providerId, status])
  @@index([city, status])
  @@index([installationType, status])
}
